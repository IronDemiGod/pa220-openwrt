#!/bin/sh
#
# PA-220: the RAM-booted image (pa220.bin, initramfs) would otherwise run
# with an empty root password, i.e. passwordless SSH and LuCI for anyone on
# the network. Give it the usual default of OpenWrt-based builds:
# root / password. Installed (eMMC) systems are not touched.
#

. /lib/functions.sh

case "$(board_name)" in
pan,pa-220)
	# only when / is the initramfs, not the ext4 root on the eMMC
	case "$(awk '$2 == "/" { t = $3 } END { print t }' /proc/mounts)" in
	rootfs|ramfs|tmpfs) ;;
	*) exit 0 ;;
	esac
	# only if no password has been set yet
	grep -q '^root::' /etc/shadow || exit 0
	printf 'password\npassword\n' | passwd root >/dev/null 2>&1
	;;
esac

exit 0
