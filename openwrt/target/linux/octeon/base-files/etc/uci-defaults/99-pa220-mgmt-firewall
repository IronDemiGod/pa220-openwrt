#!/bin/sh
#
# PA-220: put the MGT port in its own firewall zone. It accepts traffic to
# the router itself (ping, SSH, LuCI) but never forwards to or from other
# networks.
#

. /lib/functions.sh

case "$(board_name)" in
pan,pa-220)
	[ -f /etc/config/firewall ] || exit 0
	uci -q get firewall.mgmt >/dev/null && exit 0

	uci -q batch <<-EOT
		set firewall.mgmt=zone
		set firewall.mgmt.name='mgmt'
		add_list firewall.mgmt.network='mgmt'
		set firewall.mgmt.input='ACCEPT'
		set firewall.mgmt.output='ACCEPT'
		set firewall.mgmt.forward='REJECT'
		commit firewall
	EOT
	;;
esac

exit 0
