#!/bin/sh
#
# PA-220: write the system time to the DS1338 RTC whenever ntpd steps the
# clock or gains sync, so the RTC stays right even without a clean shutdown
# (sysfixtime only saves it at shutdown). The RTC is used at the next boot
# and shown by U-Boot's "date".
#

. /lib/functions.sh

[ "$(board_name)" = "pan,pa-220" ] || exit 0
[ -e /dev/rtc0 ] || exit 0

case "$ACTION" in
step|stratum)
	hwclock -w -u -f /dev/rtc0 && \
		logger -t pa220-rtc "saved '$(date)' to /dev/rtc0 ($ACTION)"
	;;
esac
