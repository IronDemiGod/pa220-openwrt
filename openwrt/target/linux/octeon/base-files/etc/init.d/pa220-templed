#!/bin/sh /etc/rc.common
# PA-220 TEMP LED: green / orange by board temperature

START=99
USE_PROCD=1

start_service() {
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "pan,pa-220" ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/pa220-templed
	procd_set_param respawn
	procd_close_instance
}
